{
  "name": "virtual-pincel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dibuja en el aire con gestos de la mano usando la cámara web (MediaPipe + React).",
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "predev": "node scripts/setup-assets.mjs",
    "prebuild": "node scripts/setup-assets.mjs",
    "dev": "vite",
